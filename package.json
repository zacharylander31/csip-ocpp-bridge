{
  "name": "csip-ocpp-bridge",
  "version": "1.0.0",
  "description": "Bridge CSIP-AUS network limits to EV chargers over OCPP",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx src/runDemo.ts",
    "typecheck": "tsc",
    "mock-csip": "tsx src/runMockCsip.ts",
    "check-csip": "tsx src/checkCsipClient.ts",
    "bridge-demo": "tsx src/runBridge.ts",
    "failsafe-demo": "tsx src/runFailsafe.ts",
    "telemetry-demo": "tsx src/runTelemetry.ts",
    "site-demo": "tsx src/runSiteMeter.ts",
    "ode-demo": "tsx src/runOdeMqtt.ts",
    "ocpp16-demo": "tsx src/runOcpp16.ts",
    "amps-demo": "tsx src/runAmps.ts",
    "reconnect-demo": "tsx src/runReconnect.ts",
    "charger-sim": "tsx src/runChargerSim.ts",
    "config-test": "tsx src/checkConfig.ts",
